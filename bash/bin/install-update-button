#!/usr/bin/env python3
"""Install the local Arch update bar button, preserving existing DMS settings."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
from datetime import datetime

repo = Path(__file__).resolve().parents[2]
config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "dms"
settings_path = config / "settings.json"
plugin_path = config / "plugin_settings.json"
source = repo / "DankMaterialShell/plugins/ArchUpdate"


def read(path):
    return json.loads(path.read_text()) if path.exists() else {}


def write(path, data):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(f.name, path)


# Validate before stopping the shell.
settings = read(settings_path)
if not settings.get("barConfigs"):
    raise SystemExit("No DMS bar configuration found in " + str(settings_path))
read(plugin_path)
subprocess.run(["dms", "kill"], check=True)
try:
    # Read after shutdown so any last settings save is preserved.
    settings = read(settings_path)
    plugins = read(plugin_path)
    backup = config / ("backup-arch-update-" + datetime.now().strftime("%Y%m%d-%H%M%S-%f"))
    backup.mkdir(parents=True)
    for path in (settings_path, plugin_path):
        if path.exists():
            shutil.copy2(path, backup / path.name)
    target = config / "plugins/ArchUpdate"
    if target.exists():
        shutil.copytree(target, backup / "ArchUpdate")
    shutil.copytree(source, target, dirs_exist_ok=True)
    plugins.setdefault("archUpdate", {})["enabled"] = True
    for bar in settings["barConfigs"]:
        if not bar.get("enabled", True):
            continue
        sections = [bar.get(key, []) for key in ("leftWidgets", "centerWidgets", "rightWidgets")]
        if any((w if isinstance(w, str) else w.get("id")) == "archUpdate" for widgets in sections for w in widgets):
            continue
        right = bar.setdefault("rightWidgets", [])
        right.insert(0, {"id": "archUpdate", "enabled": True})
    write(plugin_path, plugins)
    write(settings_path, settings)
    print("Arch update button installed. Settings backup:", backup)
finally:
    subprocess.run(["dms", "run", "--daemon"], check=True)
