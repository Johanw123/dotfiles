#!/usr/bin/env bash
# Run a Windows simulation and the GUI it starts in nested labwc/XWayland.
# This follows run_sim_labwc.sh, but accepts an arbitrary .exe instead of a
# quickSim product. The simulation remains responsible for starting its GUI.
set -euo pipefail

script_path=$(realpath "${BASH_SOURCE[0]}")

usage() {
    cat <<'EOF'
Usage: wine-labwc [--fullscreen] [--native-gui-project DIR] EXE [ARGUMENT...]

Examples:
  wine-labwc Solidarity.exe
  wine-labwc --fullscreen "/path/to/build/Solidarity.exe"
  wine-labwc Solidarity.exe -screen-fullscreen 0
  WINEPREFIX=/path/to/prefix wine-labwc Solidarity.exe

Runs from the executable's directory using your existing Wine prefix.
The outer niri window floats at 1920x1080 unless --fullscreen is given.
Unity builds default to a borderless window inside labwc, including when the
outer window is fullscreen. Explicit Unity fullscreen arguments override this.
For Solidarity, --native-gui-project runs the packaged GUI content using Linux
Godot and the Linux extension libraries in DIR. Unity continues to run in Wine.
Example:
  wine-labwc --native-gui-project "$HOME/Dev/workspaces/LapMentorGUI" Solidarity.exe
This mode also requires godot and x86_64-w64-mingw32-gcc.

All arguments after EXE are passed to the Windows application unchanged.
Close existing simulation/Godot GUI instances before launching so that the
simulation starts its GUI inside this session instead of reusing an outside one.
Requires labwc, Xwayland, alacritty, python3, niri and wine on PATH.
EOF
}

if [[ ${1:-} == --inside ]]; then
    status_file=${2:?Missing session status file}
    exe=${3:?Missing executable}
    shift 3
    native_gui_pid=""
    bridge_pid=""
    cleanup_inside() {
        local status=$?
        trap - EXIT
        for child in "$native_gui_pid" "$bridge_pid"; do
            if [[ -n $child ]]; then
                kill "$child" 2>/dev/null || true
                wait "$child" 2>/dev/null || true
            fi
        done
        printf '%s\n' "$status" > "$status_file"
        exit "$status"
    }
    trap cleanup_inside EXIT
    if [[ -z ${DISPLAY:-} || $DISPLAY == "${WINE_LABWC_OUTER_DISPLAY:-}" ]]; then
        echo "labwc did not provide a separate XWayland DISPLAY." >&2
        exit 1
    fi
    # Size the outer compositor window, as in run_sim_labwc.sh.
    python3 - <<'PY'
import json
import os
import subprocess
import time

compositor_pid = int(os.environ["LABWC_PID"])
for attempt in range(100):
    result = subprocess.run(["niri", "msg", "--json", "windows"],
                            capture_output=True, text=True, check=True)
    window = next((item for item in json.loads(result.stdout)
                   if item.get("pid") == compositor_pid), None)
    if window is not None:
        window_id = str(window["id"])
        if os.environ["WINE_LABWC_FULLSCREEN"] == "1":
            actions = [["fullscreen-window", "--id", window_id]]
        else:
            actions = [
                ["move-window-to-floating", "--id", window_id],
                ["set-window-width", "--id", window_id, "1920"],
                ["set-window-height", "--id", window_id, "1080"],
            ]
        for action in actions:
            subprocess.run(["niri", "msg", "action", *action], check=True)
        break
    time.sleep(0.1)
else:
    raise SystemExit("Could not identify the outer labwc window in niri; Wine was not started.")
PY
    cd "$(dirname "$exe")"
    printf 'Nested Wine session: %s (DISPLAY=%s)\n' "${exe##*/}" "$DISPLAY"
    # Wine and child GUI processes must use labwc's X server. Disabling the
    # Wayland driver also avoids connecting to the default outer Wayland socket
    # when WAYLAND_DISPLAY is unset. Keep other DLL overrides and WINEPREFIX.
    unset WAYLAND_DISPLAY
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}winewayland.drv="
    if [[ -n ${WINE_LABWC_GUI_PROJECT:-} ]]; then
        # Solidarity's existing external-GUI path detects a debug-titled Win32
        # window. A hidden marker lets that path use native Godot without
        # changing the simulation build or allowing a second Windows GUI.
        # Its process and the native GUI belong only to this nested session.
        python3 - <<'PYPORT'
import socket
try:
    with socket.socket() as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(("127.0.0.1", 8069))
except OSError as error:
    raise SystemExit(f"GUI port 8069 is unavailable; close existing GUI instances first: {error}")
PYPORT
        session_dir=$(dirname "$status_file")
        cat > "$session_dir/gui-bridge.c" <<'C'
#define UNICODE
#define _UNICODE
#include <windows.h>
int wmain(int argc, wchar_t **argv) {
    if (argc != 2) return 2;
    HWND window = CreateWindowExW(0, L"STATIC", L"LapMentorGUI (DEBUG) native bridge",
                                 WS_OVERLAPPED, 0, 0, 1, 1, NULL, NULL, NULL, NULL);
    if (!window) return 3;
    HANDLE ready = CreateFileW(argv[1], GENERIC_WRITE, FILE_SHARE_READ, NULL,
                              CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    if (ready == INVALID_HANDLE_VALUE) return 4;
    CloseHandle(ready);
    MSG msg;
    while (GetMessageW(&msg, NULL, 0, 0) > 0) {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }
    return 0;
}
C
        x86_64-w64-mingw32-gcc -Os -s -municode -o "$session_dir/gui-bridge.exe" \
            "$session_dir/gui-bridge.c" -luser32
        gui_pack="${exe%.exe}_Data/StreamingAssets/plugins/gui/LapMentorGUI.exe"
        godot --path "$WINE_LABWC_GUI_PROJECT" --main-pack "$gui_pack" \
            --display-driver x11 --rendering-method gl_compatibility --always-on-top \
            --log-file "$session_dir/godot.log" \
            ++ --first_scene=modules/basic_skills/basic_skills.tscn \
            >> "$WINE_LABWC_LOG" 2>&1 &
        native_gui_pid=$!
        wine "$session_dir/gui-bridge.exe" "Z:$session_dir/bridge-ready" \
            >> "$WINE_LABWC_LOG" 2>&1 &
        bridge_pid=$!
        bridge_ready=0
        for (( attempt=0; attempt<300; ++attempt )); do
            if ! kill -0 "$native_gui_pid" 2>/dev/null || ! kill -0 "$bridge_pid" 2>/dev/null; then
                echo "Native GUI or Wine bridge failed to start. See $WINE_LABWC_LOG" >&2
                exit 1
            fi
            if [[ -f $session_dir/bridge-ready ]]; then
                bridge_ready=1
                break
            fi
            sleep 0.1
        done
        if (( !bridge_ready )); then
            echo "Timed out starting the native GUI bridge. See $WINE_LABWC_LOG" >&2
            exit 1
        fi
        echo "Running packaged Godot GUI natively; Unity remains in Wine."
    fi
    # Unity must share the nested desktop with the separately owned GUI.
    # Its saved fullscreen setting otherwise applies even in a floating outer
    # labwc window. Use a borderless window by default; preserve explicit flags.
    unity_args=()
    if [[ -f $(dirname "$exe")/UnityPlayer.dll ]]; then
        explicit_fullscreen=0
        for argument in "$@"; do
            case "$argument" in
                -screen-fullscreen|-screen-fullscreen=*) explicit_fullscreen=1 ;;
            esac
        done
        if (( !explicit_fullscreen )); then
            unity_args+=(-screen-fullscreen 0)
        fi
        unity_args+=(-popupwindow)
    fi
    printf 'Wine command:'
    printf ' %q' wine "$exe" "${unity_args[@]}" "$@"
    printf '\n'
    # Keep Wine and child Godot output in the printed log as well as the terminal.
    # pipefail preserves Wine's failure status through tee.
    wine "$exe" "${unity_args[@]}" "$@" 2>&1 | tee -a "$WINE_LABWC_LOG"
    exit 0
fi

export WINE_LABWC_FULLSCREEN=0
export WINE_LABWC_GUI_PROJECT=""
while (( $# )); do
    case "$1" in
        --fullscreen) export WINE_LABWC_FULLSCREEN=1; shift ;;
        --native-gui-project)
            if (( $# < 2 )); then
                echo "--native-gui-project requires a project directory." >&2
                exit 2
            fi
            export WINE_LABWC_GUI_PROJECT=$(realpath "$2")
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
        *) break ;;
    esac
done
if (( $# == 0 )); then
    usage >&2
    exit 2
fi
if [[ ! -f $1 ]]; then
    echo "Executable not found: $1" >&2
    exit 1
fi
exe=$(realpath "$1")
shift

for dependency in labwc Xwayland alacritty python3 niri wine tee; do
    if ! command -v "$dependency" >/dev/null; then
        echo "Missing dependency: $dependency" >&2
        exit 1
    fi
done
if [[ -n $WINE_LABWC_GUI_PROJECT ]]; then
    for dependency in godot x86_64-w64-mingw32-gcc; do
        if ! command -v "$dependency" >/dev/null; then
            echo "Missing native GUI dependency: $dependency" >&2
            exit 1
        fi
    done
    if [[ ! -f $WINE_LABWC_GUI_PROJECT/project.godot ||
          ! -f $WINE_LABWC_GUI_PROJECT/addons/gdsustools/bin/libgdsustools.linux.template_debug.x86_64.so ||
          ! -f ${exe%.exe}_Data/StreamingAssets/plugins/gui/LapMentorGUI.exe ]]; then
        echo "Native GUI mode requires the Solidarity GUI pack and a LapMentorGUI project with its Linux extension." >&2
        exit 1
    fi
fi
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    echo "Run this launcher from your niri/Wayland session." >&2
    exit 1
fi
# Fail early if the desktop socket cannot be reached.
niri msg --json windows >/dev/null

config_dir=$(mktemp -d /tmp/wine-labwc.XXXXXX)
trap 'rm -rf -- "$config_dir"' EXIT
python3 - "$config_dir/rc.xml" "${exe##*/}" <<'PY'
import sys
import xml.etree.ElementTree as ET

root = ET.Element("labwc_config")
rules = ET.SubElement(root, "windowRules")
# Wine's X11 WM_CLASS is the executable name. Maximize only the simulation;
# leave the Godot overlay's bounds under the application's control.
rule = ET.SubElement(rules, "windowRule", identifier=sys.argv[2],
                     serverDecoration="no")
ET.SubElement(rule, "action", name="Maximize")
ET.SubElement(rules, "windowRule", title="*", allowAlwaysOnTop="yes")
ET.ElementTree(root).write(sys.argv[1], encoding="utf-8", xml_declaration=True)
PY
: > "$config_dir/autostart"
: > "$config_dir/shutdown"
: > "$config_dir/environment"

export WINE_LABWC_OUTER_DISPLAY=${DISPLAY:-}
printf -v session_command '%q ' alacritty -e bash "$script_path" \
    --inside "$config_dir/status" "$exe" "$@"
log_file=$(mktemp /tmp/wine-labwc.XXXXXX.log)
export WINE_LABWC_LOG=$log_file
printf 'Session log (compositor, Wine and Godot): %s\n' "$log_file"
status=0
WLR_BACKENDS=wayland WLR_WL_OUTPUTS=1 LABWC_UPDATE_ACTIVATION_ENV=0 \
    labwc --config-dir "$config_dir" --title "Wine nested session: ${exe##*/}" \
    --session "$session_command" >> "$log_file" 2>&1 || status=$?
if [[ -f $config_dir/status ]]; then
    read -r application_status < "$config_dir/status"
    if (( application_status != 0 )); then
        printf 'Wine session exited with status %s.\n' "$application_status" >&2
        status=$application_status
    fi
fi
if (( status != 0 )); then
    printf 'Nested session failed (status %s). Log: %s\n' "$status" "$log_file" >&2
    tail -n 20 "$log_file" >&2
fi
exit "$status"
